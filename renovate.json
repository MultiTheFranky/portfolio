{
    "$schema": "https://docs.renovatebot.com/renovate-schema.json",
    "extends": ["config:recommended"],
    "automerge": true,
    "automergeType": "pr",
    "platformAutomerge": true,
    "rebaseWhen": "behind-base-branch",
    "minimumReleaseAge": "2 days",
    "internalChecksFilter": "strict",
    "packageRules": [
        {
            "description": "Auto-merge every update, including majors; CI gates the merge",
            "matchUpdateTypes": [
                "major",
                "minor",
                "patch",
                "pin",
                "digest",
                "lockFileMaintenance"
            ],
            "automerge": true
        },
        {
            "description": "TypeScript 7 (native compiler) has no JS API yet; typescript-eslint and @astrojs/check only support TS <=6. Lift once they support TS 7.",
            "matchPackageNames": ["typescript"],
            "allowedVersions": "<7"
        },
        {
            "description": "The WebKit Playwright tests hang on Ubuntu 26.04 runners (#569). Lift once they pass there.",
            "matchDatasources": ["github-runners"],
            "matchPackageNames": ["ubuntu"],
            "allowedVersions": "<26"
        }
    ]
}
