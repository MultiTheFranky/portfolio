---
import Layout from "../layouts/Layout.astro";

export const prerender = true;
---

<Layout
    title="Page not found | MultiTheFranky"
    description="The page you are looking for doesn't exist."
    noindex
>
    <div class="grid min-h-[60vh] place-items-center px-6 py-24 sm:py-32 lg:px-8">
        <div class="text-center">
            <p
                class="glitch text-7xl font-extrabold sm:text-9xl"
                aria-hidden="true"
            >
                404
            </p>
            <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-5xl">
                Page not found
            </h1>
            <p class="mt-6 text-base leading-7 text-[var(--fg-muted)]">
                Sorry, we couldn't find the page you're looking for.
            </p>
            <div class="mt-10 flex items-center justify-center gap-x-6">
                <a
                    href="/"
                    class="home-btn rounded-full px-5 py-3 text-sm font-semibold text-white"
                >
                    Go back home
                </a>
                <a href="/about" class="text-sm font-semibold hover:underline">
                    About me <span aria-hidden="true">→</span>
                </a>
            </div>
        </div>
    </div>

    <style>
        .glitch {
            background: linear-gradient(120deg, #00b1bb, #38bdf8, #6366f1);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
            animation: float 3s ease-in-out infinite;
        }

        .home-btn {
            background: linear-gradient(135deg, #00838a, #0d0950);
            box-shadow: 0 10px 25px rgba(0, 177, 187, 0.3);
            transition: transform 0.2s ease;
        }

        .home-btn:hover {
            transform: translateY(-2px);
        }
    </style>
</Layout>
