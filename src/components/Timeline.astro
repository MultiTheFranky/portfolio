---
type TimelineEntry = {
    title: string;
    date: string;
    description: string;
    icon: string;
};

const timelineEntries: TimelineEntry[] = [
    {
        title: "Born",
        date: "1997",
        description: "I was born in Santander, Spain.",
        icon: "👶"
    },
    {
        title: "First program",
        date: "2009",
        description: "I wrote my first program in Java. A simple calculator.",
        icon: "💻"
    },
    {
        title: "University",
        date: "2015",
        description:
            "I started studying Computer Science at UNICAN (University of Cantabria).",
        icon: "🎓"
    },
    {
        title: "First job",
        date: "2019",
        description:
            "I started working as a Software Engineer at Incentro. Working for multiple clients like Grandvision (EssilorLuxottica) and Casashops.",
        icon: "💼"
    }
];
---

<section
    id="timeline"
    class="timeline-surface mx-auto max-w-7xl px-6 lg:px-8 mb-16 mt-16"
    aria-labelledby="timeline-title"
>
    <p class="section-eyebrow">Since 1997</p>
    <h2
        id="timeline-title"
        class="text-center text-3xl sm:text-4xl font-bold leading-tight mb-10 timeline-title"
    >
        Timeline
    </h2>

    <ol class="timeline">
        {timelineEntries.map((entry, index) => (
            <li class="timeline-item">
                <span class="timeline-icon scroll-reveal-scale">
                    <span class="timeline-icon-symbol" aria-hidden="true">
                        {entry.icon}
                    </span>
                </span>
                <div
                    class:list={[
                        "timeline-card",
                        index % 2 === 0
                            ? "scroll-reveal-left"
                            : "scroll-reveal-right"
                    ]}
                >
                    <span class="timeline-arrow" aria-hidden="true" />
                    <h3 class="timeline-heading">{entry.title}</h3>
                    <p class="timeline-description">{entry.description}</p>
                    <time class="timeline-date" datetime={entry.date}>
                        {entry.date}
                    </time>
                </div>
            </li>
        ))}
    </ol>

    <style>
        .section-eyebrow {
            margin-top: 6rem;
            text-align: center;
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            color: #006b70;
        }

        :global(.dark) .section-eyebrow {
            color: #2dd4bf;
        }

        .timeline-title {
            opacity: 0;
            animation: title-reveal 0.8s ease-out 0.2s forwards;
        }

        @keyframes title-reveal {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .timeline-surface {
            --timeline-card-bg: rgba(255, 255, 255, 0.96);
            --timeline-card-border: rgba(148, 163, 184, 0.42);
            --timeline-card-text: #0f172a;
            --timeline-card-muted: #475569;
            --timeline-card-shadow: 0 20px 45px rgba(15, 23, 42, 0.14);
            --timeline-icon-bg: linear-gradient(135deg, #1d4ed8, #2563eb);
            --timeline-icon-color: #f8fafc;
            --timeline-icon-shadow: 0 14px 28px rgba(29, 78, 216, 0.32);
            --timeline-icon-size: 3.25rem;
        }

        :global(.dark) .timeline-surface {
            --timeline-card-bg: rgba(15, 23, 42, 0.92);
            --timeline-card-border: rgba(148, 163, 184, 0.3);
            --timeline-card-text: #f1f5f9;
            --timeline-card-muted: #cbd5e1;
            --timeline-card-shadow: 0 26px 55px rgba(15, 23, 42, 0.5);
            --timeline-icon-bg: linear-gradient(135deg, #1e3a8a, #0ea5e9);
            --timeline-icon-color: #f8fafc;
            --timeline-icon-shadow: 0 18px 38px rgba(14, 165, 233, 0.35);
        }

        /* Single column on small screens: line and icons on the left,
           cards to their right. */
        .timeline {
            position: relative;
            width: 95%;
            max-width: 1170px;
            margin: 0 auto;
            padding: 2em 0;
            list-style: none;
        }

        /* The vertical line */
        .timeline::before {
            content: "";
            position: absolute;
            top: 0;
            left: calc(var(--timeline-icon-size) / 2 - 1.5px);
            width: 3px;
            height: 100%;
            background: linear-gradient(
                180deg,
                transparent,
                rgba(0, 177, 187, 0.6),
                rgba(13, 9, 80, 0.6),
                transparent
            );
            animation: timeline-line-glow 3s ease-in-out infinite;
        }

        @keyframes timeline-line-glow {
            0%,
            100% {
                box-shadow: 0 0 10px rgba(0, 177, 187, 0.3);
            }
            50% {
                box-shadow: 0 0 25px rgba(0, 177, 187, 0.6);
            }
        }

        .timeline-item {
            position: relative;
            margin: 0 0 2rem;
        }

        .timeline-item:last-child {
            margin-bottom: 0;
        }

        /* Clearfix for the floated cards on wide screens */
        .timeline-item::after {
            content: "";
            display: table;
            clear: both;
        }

        .timeline .timeline-icon {
            position: absolute;
            top: 0;
            left: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            width: var(--timeline-icon-size);
            height: var(--timeline-icon-size);
            border-radius: 50%;
            background: var(--timeline-icon-bg);
            box-shadow: var(--timeline-icon-shadow);
            color: var(--timeline-icon-color);
            font-size: 1.25rem;
            transition:
                opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1),
                transform 320ms cubic-bezier(0.4, 0, 0.2, 1),
                box-shadow 320ms ease;
        }

        /* Pulse a pre-drawn glow with opacity so the compositor can animate it */
        .timeline .timeline-icon::after {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: inherit;
            box-shadow: 0 14px 40px rgba(0, 177, 187, 0.5);
            opacity: 0;
            pointer-events: none;
            animation: icon-pulse 2s ease-in-out infinite;
        }

        @keyframes icon-pulse {
            50% {
                opacity: 1;
            }
        }

        .timeline .timeline-icon:hover {
            transform: scale(1.15) rotate(10deg);
            box-shadow: 0 20px 50px rgba(0, 177, 187, 0.5);
        }

        .timeline-icon-symbol {
            line-height: 1;
            transition: transform 0.3s ease;
        }

        .timeline-icon:hover .timeline-icon-symbol {
            transform: scale(1.2);
        }

        .timeline .timeline-card {
            position: relative;
            margin-left: calc(var(--timeline-icon-size) + 1.25rem);
            padding: 1.75rem 2rem;
            background: var(--timeline-card-bg);
            border: 1px solid var(--timeline-card-border);
            border-radius: 0.75rem;
            box-shadow: var(--timeline-card-shadow);
            color: var(--timeline-card-text);
            transition:
                opacity 0.8s cubic-bezier(0.4, 0, 0.2, 1),
                transform 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                box-shadow 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                border-color 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        }

        /* Shimmer sweep without overflow: hidden, which would clip the date
           positioned outside the card on wide screens. */
        .timeline-card::before {
            content: "";
            position: absolute;
            inset: 0;
            border-radius: inherit;
            pointer-events: none;
            background: linear-gradient(
                90deg,
                transparent 30%,
                rgba(0, 177, 187, 0.12) 50%,
                transparent 70%
            );
            background-size: 250% 100%;
            background-position: 100% 0;
            transition: background-position 0.6s ease;
        }

        .timeline-card:hover::before {
            background-position: 0% 0;
        }

        .timeline .timeline-card:hover {
            transform: translateY(-8px) scale(1.02);
            box-shadow: 0 30px 60px rgba(0, 177, 187, 0.2);
            border-color: rgba(0, 177, 187, 0.4);
        }

        /* Points from the card towards the line */
        .timeline-arrow {
            position: absolute;
            top: 16px;
            right: 100%;
            width: 0;
            height: 0;
            border: 7px solid transparent;
            border-right-color: var(--timeline-card-border);
        }

        .timeline-heading {
            font-size: 1.1rem;
            font-weight: 600;
            margin: 0 0 0.5rem;
        }

        .timeline-description {
            color: var(--timeline-card-muted);
            font-size: 0.975rem;
            line-height: 1.65;
            margin: 0;
        }

        .timeline-date {
            display: block;
            margin-top: 1.25rem;
            color: #00838a;
            font-size: 1.1rem;
            font-weight: 800;
            letter-spacing: 0.08em;
        }

        :global(.dark) .timeline-date {
            color: #2dd4bf;
        }

        @media (min-width: 1024px) {
            .timeline-item {
                margin-bottom: 2.5rem;
            }
        }

        /* Two columns: line centred, cards alternating sides and the date
           shown on the opposite side of the line. */
        @media (min-width: 1170px) {
            .timeline {
                width: 90%;
            }

            .timeline::before {
                left: 50%;
                margin-left: -1.5px;
            }

            .timeline .timeline-icon {
                left: 50%;
                margin-left: calc(var(--timeline-icon-size) / -2);
            }

            .timeline .timeline-card {
                width: 44%;
                margin-left: 0;
            }

            .timeline-arrow {
                top: 24px;
                right: auto;
                left: 100%;
                transform: rotate(180deg);
            }

            .timeline-date {
                position: absolute;
                top: 6px;
                left: 124%;
                width: 100%;
            }

            .timeline-item:nth-child(even) .timeline-card {
                float: right;
            }

            .timeline-item:nth-child(even) .timeline-arrow {
                left: auto;
                right: 100%;
                transform: none;
            }

            .timeline-item:nth-child(even) .timeline-date {
                left: auto;
                right: 124%;
                text-align: right;
            }
        }
    </style>
</section>
