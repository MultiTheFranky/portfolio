---
import ThemeIcon from "./ThemeIcon.astro";
import { SITE } from "../data/site";

const navLinks = [
    { href: "/", label: "Home" },
    { href: "/#timeline", label: "Timeline" },
    { href: "/#knowledge", label: "Skills" },
    { href: "/about", label: "About" }
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => href === currentPath;
---

<style>
    main {
        margin: auto;
        padding: 1rem;
        width: 800px;
        max-width: calc(100% - 2rem);
        color: white;
        font-size: 20px;
        line-height: 1.6;
    }

    h1 {
        font-size: 4rem;
        font-weight: 700;
        line-height: 1;
        text-align: center;
        margin-bottom: 1em;
        color: grey;
    }

    .text-gradient {
        background: linear-gradient(270deg, #00b1bb, #38bdf8, #6366f1, #00b1bb);
        background-size: 600% 600%;

        -webkit-animation: Title 30s ease infinite;
        -moz-animation: Title 30s ease infinite;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: Title 30s ease infinite;
        background-size: 400%;
        background-position: 0%;
    }

    @-webkit-keyframes Title {
        0% {
            background-position: 0% 50%;
        }
        50% {
            background-position: 100% 50%;
        }
        100% {
            background-position: 0% 50%;
        }
    }
    @-moz-keyframes Title {
        0% {
            background-position: 0% 50%;
        }
        50% {
            background-position: 100% 50%;
        }
        100% {
            background-position: 0% 50%;
        }
    }
    @keyframes Title {
        0% {
            background-position: 0% 50%;
        }
        50% {
            background-position: 100% 50%;
        }
        100% {
            background-position: 0% 50%;
        }
    }

    .contact-pill {
        background: linear-gradient(135deg, #00838a, #0d0950);
        box-shadow: 0 8px 20px rgba(0, 177, 187, 0.25);
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .contact-pill:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(0, 177, 187, 0.4);
    }

    /* Header entrance animation */
    nav {
        animation: header-slide-down 0.8s ease-out;
    }

    @keyframes header-slide-down {
        from {
            opacity: 0;
            transform: translateY(-30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Logo hover effect */
    .logo-container {
        position: relative;
        transition: transform 0.3s ease;
    }

    .logo-container:hover {
        transform: scale(1.02);
    }

    .logo-container::after {
        content: "";
        position: absolute;
        bottom: -5px;
        left: 50%;
        width: 0;
        height: 3px;
        background: linear-gradient(90deg, #00b1bb, #0d0950);
        transition: all 0.4s ease;
        transform: translateX(-50%);
        border-radius: 2px;
    }

    .logo-container:hover::after {
        width: 80%;
    }

    /* Navigation link animations */
    .nav-link {
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
    }

    .nav-link::before {
        content: "";
        position: absolute;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: linear-gradient(90deg, #00b1bb, #0d0950);
        transform: translateX(-100%);
        transition: transform 0.3s ease;
    }

    .nav-link:hover::before {
        transform: translateX(0);
    }

    .nav-link:hover {
        color: #00838a !important;
    }

    :global(.dark) .nav-link:hover {
        color: #00d4df !important;
    }

    /* Floating animation for nav items */
    .nav-item {
        animation: nav-float 0.6s ease-out backwards;
    }

    .nav-item:nth-child(1) {
        animation-delay: 0.1s;
    }
    .nav-item:nth-child(2) {
        animation-delay: 0.2s;
    }
    .nav-item:nth-child(3) {
        animation-delay: 0.3s;
    }
    .nav-item:nth-child(4) {
        animation-delay: 0.4s;
    }

    @keyframes nav-float {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Mobile menu button animation */
    .menu-btn {
        transition: all 0.3s ease;
    }

    .menu-btn:hover {
        transform: scale(1.1);
        color: #00b1bb;
    }

    .menu-btn:active {
        transform: scale(0.95);
    }

    /* Glass effect for header background */
    .header-glass {
        background: rgba(255, 255, 255, 0.8);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(0, 177, 187, 0.1);
        transition: all 0.3s ease;
    }

    :global(.dark) .header-glass {
        background: rgba(13, 9, 80, 0.8);
        border-bottom: 1px solid rgba(0, 177, 187, 0.2);
    }
</style>

<nav class="header-glass sticky top-0 z-50" aria-label="Main navigation">
    <div
        class="max-w-screen-xl flex flex-wrap items-center justify-between mx-auto px-4 py-3 sm:p-4"
    >
        <a
            href="/"
            class="flex items-center logo-container"
            aria-label={`${SITE.name} — home`}
        >
            <span
                class="sm:mx-4 text-3xl sm:text-5xl lg:text-6xl text-gray-500 dark:text-gray-300 font-semibold tracking-tight"
            >
                MultiThe<span class="text-gradient">Franky</span>
            </span>
        </a>
        <div class="flex items-center gap-2 md:hidden">
            <ThemeIcon id="themeToggleMobile" />
            <button
                id="menu-toggle"
                type="button"
                class="menu-btn inline-flex items-center p-2 w-10 h-10 justify-center text-sm text-gray-600 rounded-lg hover:bg-gray-100 dark:text-gray-300 dark:hover:bg-white/10"
                aria-controls="navbar-default"
                aria-expanded="false"
            >
                <span class="sr-only">Toggle main menu</span>
                <svg
                    class="w-5 h-5"
                    aria-hidden="true"
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 17 14"
                >
                    <path
                        stroke="currentColor"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M1 1h15M1 7h15M1 13h15"></path>
                </svg>
            </button>
        </div>
        <div class="hidden w-full md:block md:w-auto" id="navbar-default">
            <ul
                class="font-medium flex flex-col p-4 md:p-0 mt-4 border border-gray-200 dark:border-white/10 rounded-lg md:flex-row md:items-center md:space-x-8 md:mt-0 md:border-0"
            >
                {
                    navLinks.map((link) => (
                        <li class="nav-item">
                            <a
                                href={link.href}
                                class:list={[
                                    "nav-link block py-2 pl-3 pr-4 rounded md:p-0 hover:bg-gray-100 md:hover:bg-transparent dark:hover:bg-white/10 md:dark:hover:bg-transparent",
                                    isCurrent(link.href)
                                        ? "text-[#00838a] dark:text-[#00d4df] font-semibold"
                                        : "text-gray-900 dark:text-white"
                                ]}
                                aria-current={
                                    isCurrent(link.href) ? "page" : undefined
                                }
                            >
                                {link.label}
                            </a>
                        </li>
                    ))
                }
                <li class="nav-item">
                    <a
                        href={`mailto:${SITE.email}`}
                        class="contact-pill inline-block mt-2 md:mt-0 px-4 py-2 rounded-full text-sm font-semibold text-white"
                        >Contact</a
                    >
                </li>
                <li class="nav-item hidden md:list-item">
                    <ThemeIcon />
                </li>
            </ul>
        </div>
    </div>
</nav>

<script>
    const initMenu = () => {
        const toggle = document.getElementById("menu-toggle");
        const menu = document.getElementById("navbar-default");
        if (!toggle || !menu) return;

        const setOpen = (open: boolean) => {
            menu.classList.toggle("hidden", !open);
            toggle.setAttribute("aria-expanded", String(open));
        };

        toggle.addEventListener("click", () => {
            setOpen(toggle.getAttribute("aria-expanded") !== "true");
        });

        menu.querySelectorAll("a").forEach((link) =>
            link.addEventListener("click", () => setOpen(false))
        );

        document.addEventListener("keydown", (event) => {
            if (
                event.key === "Escape" &&
                toggle.getAttribute("aria-expanded") === "true"
            ) {
                setOpen(false);
                toggle.focus();
            }
        });
    };

    initMenu();
</script>
