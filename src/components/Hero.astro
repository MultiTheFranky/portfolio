---
import { Image } from "astro:assets";
import aboutImage from "../assets/about.png";
import { SITE, socials, knowledgeGroups } from "../data/site";

const roles = [
    "Software Engineer",
    "Full-stack Developer",
    "Cloud & DevOps tinkerer",
    "Lifelong learner"
];

const currentYear = new Date().getFullYear();
const allSkills = knowledgeGroups.flatMap((group) => group.knowledge);
const stats = [
    { value: `${currentYear - 2009}+`, label: "Years coding" },
    { value: `${currentYear - 2019}+`, label: "Years in industry" },
    { value: `${allSkills.length}`, label: "Technologies" }
];

const orbitSkills = ["React", "Astro", "NodeJS", "Docker"]
    .map((name) => allSkills.find((skill) => skill.name === name))
    .filter((skill) => skill !== undefined);

const heroSocials = socials.filter((social) =>
    ["Github", "Linkedin"].includes(social.name)
);
---

<section
    class="hero relative mx-auto max-w-7xl px-6 lg:px-8 pt-12 pb-16 sm:pt-20 lg:pt-28"
    aria-labelledby="hero-title"
>
    <div class="grid items-center gap-14 lg:grid-cols-[1.2fr_1fr]">
        <div class="text-center lg:text-left">
            <p class="hero-badge hero-in" style="--d: 0ms">
                <span class="pulse-dot" aria-hidden="true"></span>
                Based in Santander, Spain
            </p>

            <h1
                id="hero-title"
                class="hero-in mt-6 text-4xl font-extrabold tracking-tight sm:text-6xl lg:text-7xl"
                style="--d: 100ms"
            >
                <span
                    class="block text-lg font-semibold tracking-normal text-[var(--fg-muted)] sm:text-xl"
                    >Hi, I'm</span
                >
                Francisco <span class="hero-gradient">“Franky”</span> Álamo
            </h1>

            <p
                class="hero-in mt-5 text-xl font-semibold sm:text-2xl"
                style="--d: 200ms"
            >
                <span class="sr-only">{SITE.jobTitle}</span>
                <span aria-hidden="true">
                    <span id="typed-role" class="typed-role">{roles[0]}</span
                    ><span class="caret">|</span>
                </span>
            </p>

            <p
                class="hero-in mx-auto mt-6 max-w-xl text-base leading-7 text-[var(--fg-muted)] sm:text-lg lg:mx-0"
                style="--d: 300ms"
            >
                I build fast, accessible web experiences and the cloud plumbing
                behind them. Currently at <strong class="text-[var(--fg)]"
                    >Incentro</strong
                >, shipping e-commerce platforms for brands like GrandVision and
                Casashops.
            </p>

            <div
                class="hero-in mt-9 flex flex-wrap items-center justify-center gap-4 lg:justify-start"
                style="--d: 400ms"
            >
                <a href={`mailto:${SITE.email}`} class="btn-primary">
                    Get in touch
                    <svg
                        aria-hidden="true"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        ><path d="M5 12h14M13 5l7 7-7 7"></path></svg
                    >
                </a>
                <a href="/about" class="btn-secondary">More about me</a>
                <div class="flex items-center gap-3">
                    {
                        heroSocials.map((social) => (
                            <a
                                href={social.link}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="social-chip"
                                aria-label={`${social.name} (opens in a new tab)`}
                            >
                                <img
                                    src={social.icon}
                                    alt=""
                                    width="22"
                                    height="22"
                                    class="dark:invert"
                                />
                            </a>
                        ))
                    }
                </div>
            </div>

            <dl
                class="hero-in mt-12 grid max-w-lg grid-cols-3 gap-4 mx-auto lg:mx-0"
                style="--d: 500ms"
            >
                {
                    stats.map((stat) => (
                        <div class="stat-card">
                            <dt class="text-xs font-medium uppercase tracking-wider text-[var(--fg-muted)]">
                                {stat.label}
                            </dt>
                            <dd class="stat-value order-first text-3xl font-extrabold sm:text-4xl">
                                {stat.value}
                            </dd>
                        </div>
                    ))
                }
            </dl>
        </div>

        <div class="hero-in relative mx-auto" style="--d: 200ms">
            <div class="blob blob-a" aria-hidden="true"></div>
            <div class="blob blob-b" aria-hidden="true"></div>
            <div class="avatar-ring">
                <Image
                    src={aboutImage}
                    alt={`Portrait of ${SITE.author}`}
                    widths={[360, 560, 720]}
                    sizes="(min-width: 1024px) 352px, 78vw"
                    loading="eager"
                    fetchpriority="high"
                    class="avatar"
                />
            </div>
            <ul class="orbit" aria-hidden="true">
                {
                    orbitSkills.map((skill, index) => (
                        <li class="orbit-item" style={`--i: ${index}`}>
                            <img
                                src={skill.icon}
                                alt=""
                                width="28"
                                height="28"
                                loading="lazy"
                            />
                        </li>
                    ))
                }
            </ul>
        </div>
    </div>

    <a href="#timeline" class="scroll-cue" aria-label="Scroll to timeline">
        <span class="mouse" aria-hidden="true"><span class="wheel"></span></span
        >
    </a>
</section>

<section class="marquee" aria-label="Technologies I work with">
    <ul class="marquee-track">
        {
            [...allSkills, ...allSkills].map((skill, index) => (
                <li
                    class="marquee-item"
                    aria-hidden={index >= allSkills.length ? "true" : undefined}
                >
                    <img
                        src={skill.icon}
                        alt=""
                        width="28"
                        height="28"
                        loading="lazy"
                        class={skill.inverted ? "invert-on-dark" : ""}
                    />
                    <span>{skill.name}</span>
                </li>
            ))
        }
    </ul>
</section>

<style>
    .hero-in {
        animation: hero-in 0.8s cubic-bezier(0.2, 0.9, 0.2, 1) both;
        animation-delay: var(--d, 0ms);
    }

    @keyframes hero-in {
        from {
            opacity: 0;
            transform: translateY(24px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.4rem 0.9rem;
        border-radius: 9999px;
        font-size: 0.875rem;
        font-weight: 600;
        border: 1px solid rgba(0, 177, 187, 0.35);
        background: rgba(0, 177, 187, 0.08);
        color: #00737a;
    }

    :global(.dark) .hero-badge {
        color: #5eead4;
    }

    .pulse-dot {
        position: relative;
        width: 0.55rem;
        height: 0.55rem;
        border-radius: 9999px;
        background: #10b981;
    }

    .pulse-dot::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        background: inherit;
        animation: ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
    }

    @keyframes ping {
        75%,
        100% {
            transform: scale(2.4);
            opacity: 0;
        }
    }

    .hero-gradient,
    .stat-value {
        background: linear-gradient(120deg, #00b1bb, #38bdf8, #6366f1, #00b1bb);
        background-size: 300% auto;
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: gradient-pan 8s ease infinite;
    }

    @keyframes gradient-pan {
        0%,
        100% {
            background-position: 0% 50%;
        }
        50% {
            background-position: 100% 50%;
        }
    }

    .typed-role {
        color: #00838a;
    }

    :global(.dark) .typed-role {
        color: #2dd4bf;
    }

    .caret {
        margin-left: 2px;
        color: #00b1bb;
        animation: blink 1s step-end infinite;
    }

    @keyframes blink {
        50% {
            opacity: 0;
        }
    }

    .btn-primary,
    .btn-secondary {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.85rem 1.5rem;
        border-radius: 9999px;
        font-weight: 600;
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease,
            background-color 0.2s ease;
    }

    .btn-primary {
        color: #fff;
        background: linear-gradient(135deg, #00838a, #0d0950);
        box-shadow: 0 12px 30px rgba(0, 177, 187, 0.35);
    }

    .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 18px 40px rgba(0, 177, 187, 0.5);
    }

    .btn-primary svg {
        transition: transform 0.2s ease;
    }

    .btn-primary:hover svg {
        transform: translateX(4px);
    }

    .btn-secondary {
        border: 1px solid rgba(100, 116, 139, 0.4);
        background: rgba(255, 255, 255, 0.6);
        backdrop-filter: blur(8px);
    }

    :global(.dark) .btn-secondary {
        background: rgba(255, 255, 255, 0.06);
        border-color: rgba(203, 213, 225, 0.25);
    }

    .btn-secondary:hover {
        transform: translateY(-3px);
        border-color: #00b1bb;
    }

    .social-chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 9999px;
        border: 1px solid rgba(100, 116, 139, 0.3);
        transition:
            transform 0.2s ease,
            border-color 0.2s ease;
    }

    .social-chip:hover {
        transform: translateY(-3px) rotate(-6deg);
        border-color: #00b1bb;
    }

    .stat-card {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
        padding: 1rem 0.75rem;
        border-radius: 1rem;
        text-align: center;
        border: 1px solid rgba(148, 163, 184, 0.3);
        background: rgba(255, 255, 255, 0.55);
        backdrop-filter: blur(10px);
        transition: transform 0.3s ease;
    }

    :global(.dark) .stat-card {
        background: rgba(15, 23, 42, 0.45);
    }

    .stat-card:hover {
        transform: translateY(-4px);
    }

    /* Avatar */
    .avatar-ring {
        position: relative;
        width: min(78vw, 22rem);
        aspect-ratio: 1;
        padding: 6px;
        border-radius: 9999px;
        background: conic-gradient(
            from var(--angle, 0deg),
            #00b1bb,
            #38bdf8,
            #6366f1,
            #0d0950,
            #00b1bb
        );
        animation: spin-ring 6s linear infinite;
        box-shadow: 0 30px 80px rgba(0, 177, 187, 0.3);
    }

    @property --angle {
        syntax: "<angle>";
        initial-value: 0deg;
        inherits: false;
    }

    @keyframes spin-ring {
        to {
            --angle: 360deg;
        }
    }

    .avatar {
        width: 100%;
        height: 100%;
        border-radius: 9999px;
        object-fit: cover;
        object-position: 50% 8%;
        border: 4px solid #f8fafc;
    }

    :global(.dark) .avatar {
        border-color: #0d0950;
    }

    .blob {
        position: absolute;
        z-index: -1;
        filter: blur(50px);
        opacity: 0.55;
        border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;
        animation: morph 10s ease-in-out infinite;
    }

    .blob-a {
        width: 70%;
        height: 70%;
        top: -10%;
        left: -15%;
        background: #00b1bb;
    }

    .blob-b {
        width: 60%;
        height: 60%;
        bottom: -10%;
        right: -15%;
        background: #6366f1;
        animation-delay: -5s;
    }

    .orbit {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    .orbit-item {
        position: absolute;
        top: 50%;
        left: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 3.25rem;
        height: 3.25rem;
        margin: -1.625rem;
        border-radius: 9999px;
        background: rgba(255, 255, 255, 0.9);
        box-shadow: 0 10px 25px rgba(15, 23, 42, 0.18);
        transform: rotate(calc(var(--i) * 90deg + 45deg))
            translateX(min(42vw, 12.5rem))
            rotate(calc(var(--i) * -90deg - 45deg));
        animation: bob 4s ease-in-out infinite;
        animation-delay: calc(var(--i) * -1s);
    }

    :global(.dark) .orbit-item {
        box-shadow: 0 10px 25px rgba(0, 177, 187, 0.3);
    }

    @keyframes bob {
        0%,
        100% {
            translate: 0 0;
        }
        50% {
            translate: 0 -10px;
        }
    }

    /* Scroll cue */
    .scroll-cue {
        display: none;
        margin: 4rem auto 0;
        width: fit-content;
    }

    @media (min-width: 1024px) {
        .scroll-cue {
            display: block;
        }
    }

    .mouse {
        display: block;
        width: 26px;
        height: 42px;
        border: 2px solid currentColor;
        border-radius: 14px;
        opacity: 0.6;
        position: relative;
    }

    .wheel {
        position: absolute;
        left: 50%;
        top: 8px;
        width: 4px;
        height: 8px;
        margin-left: -2px;
        border-radius: 2px;
        background: #00b1bb;
        animation: wheel 1.6s ease-in-out infinite;
    }

    @keyframes wheel {
        0% {
            opacity: 1;
            transform: translateY(0);
        }
        100% {
            opacity: 0;
            transform: translateY(14px);
        }
    }

    /* Tech marquee */
    .marquee {
        overflow: hidden;
        padding: 1.25rem 0;
        border-block: 1px solid rgba(148, 163, 184, 0.25);
        background: rgba(255, 255, 255, 0.35);
        mask-image: linear-gradient(
            90deg,
            transparent,
            #000 10%,
            #000 90%,
            transparent
        );
    }

    :global(.dark) .marquee {
        background: rgba(15, 23, 42, 0.3);
    }

    .marquee-track {
        display: flex;
        gap: 2.5rem;
        width: max-content;
        animation: marquee 45s linear infinite;
    }

    .marquee:hover .marquee-track {
        animation-play-state: paused;
    }

    @keyframes marquee {
        to {
            transform: translateX(calc(-50% - 1.25rem));
        }
    }

    .marquee-item {
        display: flex;
        align-items: center;
        gap: 0.6rem;
        font-weight: 600;
        white-space: nowrap;
        color: var(--fg-muted);
    }

    /* Fixed box so tall logos (e.g. MongoDB) don't scale up via height: auto */
    .marquee-item img {
        width: 28px;
        height: 28px;
        object-fit: contain;
    }

    @media (prefers-reduced-motion: reduce) {
        .marquee-track {
            flex-wrap: wrap;
            justify-content: center;
            width: auto;
        }

        .marquee-item[aria-hidden="true"] {
            display: none;
        }
    }
</style>

<script define:vars={{ roles }}>
    (() => {
        const target = document.getElementById("typed-role");
        if (
            !target ||
            window.matchMedia("(prefers-reduced-motion: reduce)").matches
        ) {
            return;
        }

        let roleIndex = 0;
        let charIndex = roles[0].length;
        let deleting = true;

        const tick = () => {
            const role = roles[roleIndex];
            charIndex += deleting ? -1 : 1;
            target.textContent = role.slice(0, charIndex);

            let delay = deleting ? 45 : 90;
            if (!deleting && charIndex === role.length) {
                deleting = true;
                delay = 2200;
            } else if (deleting && charIndex === 0) {
                deleting = false;
                roleIndex = (roleIndex + 1) % roles.length;
                delay = 350;
            }
            setTimeout(tick, delay);
        };

        setTimeout(tick, 2500);
    })();
</script>
