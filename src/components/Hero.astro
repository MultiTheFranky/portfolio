---
import { Image } from "astro:assets";
import aboutImage from "../assets/about.png";
import { SITE, socials } from "../data/site";

const heroSocials = socials.filter((social) =>
    ["Github", "Linkedin"].includes(social.name)
);
---

<section
    class="hero relative mx-auto max-w-7xl px-6 lg:px-8 pt-12 pb-16 sm:pt-20 lg:pt-28"
    aria-labelledby="hero-title"
>
    <div class="grid items-center gap-14 lg:grid-cols-[1.2fr_1fr]">
        <div class="text-center lg:text-left">
            <p class="hero-badge hero-in" style="--d: 0ms">
                Based in Santander, Spain
            </p>

            <h1
                id="hero-title"
                class="hero-in mt-6 text-4xl font-extrabold tracking-tight sm:text-6xl lg:text-7xl"
                style="--d: 100ms"
            >
                <span class="block text-lg font-semibold tracking-normal text-[var(--fg-muted)] sm:text-xl">
                    Hi, I'm
                </span>
                Francisco “Franky” Álamo
            </h1>

            <p
                class="hero-in mt-5 text-xl font-semibold sm:text-2xl"
                style="--d: 200ms"
            >
                <span class="hero-role">{SITE.jobTitle}</span>
            </p>

            <p
                class="hero-in mx-auto mt-6 max-w-xl text-base leading-7 text-[var(--fg-muted)] sm:text-lg lg:mx-0"
                style="--d: 300ms"
            >
                I build fast, accessible websites and the cloud plumbing behind
                them. Currently at{" "}
                <strong class="text-[var(--fg)]">Incentro</strong>, shipping
                e-commerce platforms for brands like GrandVision and Casashops.
            </p>

            <div
                class="hero-in mt-9 flex flex-wrap items-center justify-center gap-4 lg:justify-start"
                style="--d: 400ms"
            >
                <a href={`mailto:${SITE.email}`} class="btn-primary">
                    Get in touch
                    <svg
                        aria-hidden="true"
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M5 12h14M13 5l7 7-7 7"></path>
                    </svg>
                </a>
                <a href="/about" class="btn-secondary">
                    More about me
                </a>
                <div class="flex items-center gap-3">
                    {heroSocials.map((social) => (
                        <a
                            href={social.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="social-chip"
                            aria-label={`${social.name} profile (opens in a new tab)`}
                        >
                            <img
                                src={social.icon}
                                alt=""
                                width="22"
                                height="22"
                                class="dark:invert"
                            />
                        </a>
                    ))}
                </div>
            </div>
        </div>

        <div class="hero-in relative mx-auto" style="--d: 200ms">
            <div class="avatar-ring">
                <Image
                    src={aboutImage}
                    alt={`Portrait of ${SITE.author}`}
                    widths={[360, 560, 720]}
                    sizes="(min-width: 1024px) 352px, 78vw"
                    loading="eager"
                    fetchpriority="high"
                    class="avatar"
                />
            </div>
        </div>
    </div>
</section>

<style>
    .hero-in {
        animation: hero-in 0.8s cubic-bezier(0.2, 0.9, 0.2, 1) both;
        animation-delay: var(--d, 0ms);
    }

    @keyframes hero-in {
        from {
            opacity: 0;
            transform: translateY(24px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.6rem;
        padding: 0.4rem 0.9rem;
        border-radius: 9999px;
        font-size: 0.875rem;
        font-weight: 600;
        border: 1px solid rgba(0, 177, 187, 0.35);
        background: rgba(0, 177, 187, 0.08);
        color: #00737a;
    }

    :global(.dark) .hero-badge {
        color: #5eead4;
    }

    .hero-role {
        color: #00838a;
    }

    :global(.dark) .typed-role {
        color: #2dd4bf;
    }

    .btn-primary,
    .btn-secondary {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.85rem 1.5rem;
        border-radius: 9999px;
        font-weight: 600;
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease,
            background-color 0.2s ease;
    }

    .btn-primary {
        color: #fff;
        background: linear-gradient(135deg, #00838a, #0d0950);
        box-shadow: 0 12px 30px rgba(0, 177, 187, 0.35);
    }

    .btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 18px 40px rgba(0, 177, 187, 0.5);
    }

    .btn-primary svg {
        transition: transform 0.2s ease;
    }

    .btn-primary:hover svg {
        transform: translateX(4px);
    }

    .btn-secondary {
        border: 1px solid rgba(100, 116, 139, 0.4);
        background: rgba(255, 255, 255, 0.6);
        backdrop-filter: blur(8px);
    }

    :global(.dark) .btn-secondary {
        background: rgba(255, 255, 255, 0.06);
        border-color: rgba(203, 213, 225, 0.25);
    }

    .btn-secondary:hover {
        transform: translateY(-3px);
        border-color: #00b1bb;
    }

    .social-chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 9999px;
        border: 1px solid rgba(100, 116, 139, 0.3);
        transition:
            transform 0.2s ease,
            border-color 0.2s ease;
    }

    .social-chip:hover {
        transform: translateY(-3px) rotate(-6deg);
        border-color: #00b1bb;
    }

    /* Avatar */
    .avatar-ring {
        position: relative;
        width: min(78vw, 22rem);
        aspect-ratio: 1;
        padding: 6px;
        border-radius: 9999px;
        background: #00b1bb;
        box-shadow: 0 30px 80px rgba(0, 177, 187, 0.3);
    }

    .avatar {
        width: 100%;
        height: 100%;
        border-radius: 9999px;
        object-fit: cover;
        object-position: 50% 8%;
        border: 4px solid #f8fafc;
    }

    :global(.dark) .avatar {
        border-color: #0d0950;
    }
</style>
